# EcoPulseAI Environment Variables
# NOTE: No API keys are strictly required by default. Free open-access Open-Meteo weather feeds
# and open-source GIS basemaps are active out-of-the-box.

# (Optional) Secondary weather comparison provider: WeatherAPI.com
# Configure on your Node.js backend (or in server/.env):
WEATHERAPI_KEY=your_weatherapi_key_here

# (Optional) CARTO Basemaps API Key if you want to use authenticated CARTO Dark tiles:
# Get free key from: https://carto.com/basemaps
VITE_CARTO_API_KEY=

# (Optional) Google Maps API Key if you want Google Satellite / Hybrid tiles:
# Get from Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=

# (Optional) OpenWeatherMap API Key for additional external station ingestion:
# Get from: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=
