PORT=5001
MONGODB_URI=mongodb://localhost:27017/ecopulseai
NODE_ENV=development
# Optional: Set to true to force in-memory geospatial mode without connecting to MongoDB
USE_IN_MEMORY_DB=false

# Weather Data Providers:
# Open-Meteo is the primary provider (free, open-access, CC BY 4.0 attribution, requires no key).
# WeatherAPI.com is the secondary/comparison provider (optional, requires a free or commercial API key).
# If WEATHERAPI_KEY is omitted, EcoPulse AI operates smoothly using Open-Meteo alone.
WEATHERAPI_KEY=your_weatherapi_key_here

# Optional: In-memory cache TTL overrides in milliseconds
# WEATHER_CACHE_TTL_MS=600000       # 10 minutes (default)
# AIR_QUALITY_CACHE_TTL_MS=900000   # 15 minutes (default)
# GEOCODING_CACHE_TTL_MS=3600000    # 1 hour (default)
